{% extends 'base.html.twig' %}

{% block title %}New Order{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-evenly p-1 ">
            <div class="col-md-5 card-header bg-white border-bottom p-2 border-0 shadow-sm mb-4" style=" border-radius: 12px; ">
                {% if step==1 %}
                    <h3><i class="fas fa-credit-card me-2"></i>Mode de Paiement</h3>
                    {{ include('order/paymentFormOrder.html.twig') }}
                {% elseif step==2 %}
                    <h3>Adresse de Livraison</h3>
                    {{ include('order/addressFormOrder.html.twig') }}
                {% elseif step==3 %}
                    <h3>Confirmation d'Adresse</h3>
                    {{ include('order/confirmAddressFormOrder.html.twig') }}
                {% endif %}

            </div>

            <div class="col-md-5 ">
                {% if step==2 or step==3 or step==1 %}
                    {{ include('order/step1Display.html.twig' , {order:orderDetailsDisplay}) }}
                {% else %}
                    {{ include('order/step3Display.html.twig' , {order:orderDetailsDisplay, adress:address}) }}
                {% endif %}
                <a href="{{ path('app_cart') }}" class="btn p-2" style="background-color: #FFF7EB;">Annuler</a>
            </div>
        </div>
        {% if step!=1 %}
           <a href="{{ path('app_order_new' ,{step:(step-1)} )}}" class="btn">Back</a>
        {% endif %}
    </div>



{% endblock %}