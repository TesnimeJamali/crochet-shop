<div class="d-flex flex-column gap-3">
{{ form_start(form) }}
    {{ form_widget(form.first_name, {
        'attr': {'class': 'form-control', 'placeholder': 'Enter first name'}
    }) }}
    {{ form_widget(form.last_name, {
        'attr': {'class': 'form-control', 'placeholder': 'Enter last name'}
    }) }}
    {% if not app.session.has("email") %}
        {{ form_widget(form.email, {
            'attr': {'class': 'form-control', 'placeholder': 'email@gmail.com','label':'email'}
        }) }}
    {% endif %}

    {{ form_widget(form.phone, {
        'attr': {'class': 'form-control', 'placeholder': '+216 xx xxx xxx'}
    }) }}

    {{ form_widget(form.address, {
        'attr': {'class': 'form-control', 'placeholder': 'address'}
    }) }}

    {{ form_widget(form.governorate, {
        'attr': {'class': 'form-control'}
    }) }}

    {{ form_widget(form.ZIPCode, {
        'attr': {'class': 'form-control', 'placeholder': 'xxxx'}
    }) }}
<button class="btn">{{ form_widget(form.next)}}</button>
{{ form_end(form) }}

</div>