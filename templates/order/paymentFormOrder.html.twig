{{ form_start(form, {'attr': {'class': 'payment-method-form'} }) }}

<div class="container mt-4">
    <div class="row justify-content-start">
        <div class="col-md-10">
                    {% for choice in form.paymentMethod %}
                        <div class="payment-option mb-3">
                            {{ form_widget(choice, {'attr': {'class': 'btn-check'} }) }}

                            <label for="{{ choice.vars.id }}"
                                   class="btn btn-outline-primary d-flex align-items-center p-3 rounded-3 w-100"
                                   style="background-color: #FFF7EB; border-color: #d3d3d3; text-align: left;">

                                <div class="payment-icon me-3">
                                    {% if choice.vars.value == 'stripe' %}
                                        <i class="fab fa-cc-stripe fa-2x" style="color: #635bff;"></i>
                                    {% elseif choice.vars.value == 'cash' %}
                                        <i class="fas fa-money-bill-wave fa-2x" style="color: #28a745;"></i>
                                    {% else %}
                                        <i class="fas fa-credit-card fa-2x" style="color: #6c757d;"></i>
                                    {% endif %}
                                </div>

                                <div class="payment-details flex-grow-1">
                                    <h5 class="mb-1">{{ form_label(choice) }}</h5>
                                    {% if choice.vars.value == 'stripe' %}
                                        <small class="text-muted">Payer en toute sécurité par carte bancaire</small>
                                    {% elseif choice.vars.value == 'cash' %}
                                        <small class="text-muted">Payez à la réception de votre commande</small>
                                    {% endif %}
                                </div>

                                <div class="payment-selector ms-2">
                                    <i class="fas fa-check-circle fa-lg text-success"></i>
                                </div>
                            </label>
                        </div>
                    {% endfor %}

        </div>
    </div>
</div>

{{ form_end(form) }}

<style>
    .payment-option label:hover {
        background-color: #e8f4fc !important;
        border-color: #a8d8ea !important;
    }

    .btn-check:checked + label {
        background-color: #e8f4fc !important;
        border: 2px solid #a8d8ea !important;
    }

    .btn-check:checked + label .payment-selector i {
        opacity: 1;
    }

    .payment-selector i {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .btn-pastel-primary:hover {
        background-color: #92c9e0 !important;
    }
</style>
