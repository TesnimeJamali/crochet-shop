<section class="top-selling-products py-5  ">
    <div class="container">
        <h2 class="text-center mb-5">Nos Meilleures Ventes!</h2>

        <div id="productsCarousel" class="carousel slide  " data-bs-ride="carousel">
            <div class="carousel-inner p-5">
                {% set productGroups = products|batch(3) %}

                {% for group in productGroups %}
                    <div class="carousel-item {% if loop.first %}active{% endif %}">
                        <div class="row g-4">
                            {% for product in group %}
                                <div class="col-md-4">

                                    <div class="card h-100 product-card">
                                        {% if product.imageName %}
                                        <img src="{{ asset('uploads/products/' ~ product.imageName ) }}"
                                             class="card-img-top"
                                             alt="{{ product.name }}"
                                             style="height: 180px; object-fit: cover;">
                                        {% endif %}

                                        <div class="card-body">
                                            <h5 class="card-title">{{ product.name }}</h5>
                                            <p class="card-text">
                                                <strong>Prix:</strong> {{ product.price}} DT<br>
                                            </p>
                                        </div>

                                        <div class="card-footer bg-white">
                                            <a href="{{ path('add', {'id': product.id}) }}" class="btn custom-cart-btn">
                                                <i class="fas fa-cart-plus me-1"></i> Ajouter
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# Carousel Controls #}
            <button class="carousel-control-prev" type="button" data-bs-target="#productsCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Precident</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#productsCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Suivant</span>
            </button>
        </div>
    </div>
</section>