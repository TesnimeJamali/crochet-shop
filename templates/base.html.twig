<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Crochet D'Or{% endblock %}</title>
    {# Favicon #}
    <link rel="icon" href="{{ asset('image/icon.png') }}" sizes="any">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Adam+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% endblock %}
</head>
<body>
{# Bootstrap Navbar #}
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #8bd1d2;">
    <div class="container-fluid">
        {# Logo & Brand (LEFT) #}
        <a class="navbar-brand d-flex align-items-center" href="{{ path('app_welcome') }}">
            <img src="{{ asset('image/logo.png') }}" alt="Logo" width="50" height="50" class="me-2">
            <strong>Crochet D'Or</strong>
        </a>

        {# Toggler for mobile #}
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        {# Navigation content #}
        <div class="collapse navbar-collapse justify-content-between" id="navbarContent">
            {# CENTER: Navigation Links #}
            <ul class="navbar-nav mx-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="{{ path('app_welcome') }}">Acceuil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_contact') }}">Contact</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('shop') }}">Boutique</a>
                </li>
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_products') }}">Administration</a>
                </li>
                {% endif %}
            </ul>

            {# RIGHT: Icons #}
            <ul class="navbar-nav">
                <form class="d-flex" method="get" action="{{ path('shop') }}">
                    <input class="form-control me-2" type="search" name="q" value="{{ app.request.get('q') }}" placeholder="Recherche Produits" aria-label="Search">
                    <button class="btn btn-outline-light" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </form>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_favoris') }}">
                        <i class="fa-solid fa-heart" style="color: #fff;"></i>
                    </a>
                </li>
                {% endif %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-user" style="color: #fff;"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                        {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li><a class="dropdown-item py-2" href="{{ path('app_login') }}">
                                    <i class="fa-solid fa-right-to-bracket me-2 " style="color: #8bd1d2"></i><span class="fw-medium">Se connecter</span>
                                </a></li>
                            <li><a class="dropdown-item py-2" href="{{ path('app_register') }}">
                                    <i class="fa-solid fa-user-plus me-2 " style="color: #ffd1dc;"></i><span class="fw-medium">S'inscrire</span>
                                </a></li>
                        {% else %}
                            <li>
                                <a class="dropdown-item py-2" href="{{ path('app_profile') }}"><i class="fa-solid fa-user-gear me-2 " style="color: #8bd1d2"></i><span class="fw-medium">Mon profil</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}">
                                    <i class="fa-solid fa-power-off me-2"></i><span class="fw-medium">Se déconnecter</span>
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_cart') }}">
                        <i class="fa-solid fa-shopping-cart" style="color: #fff;"></i>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container mt-4">
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <a href="{{ path('app_cart') }}" class="text-decoration-none">
                    <div id="flash" class="alert alert-dismissible shadow-sm border border-secondary"
                         style="background-color: white; color: black; min-width: 300px; cursor: pointer;">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </a>
            {% endfor %}
        {% endfor %}
    </div>


    {% block body %}{% endblock %}
</main>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const alerts = document.querySelectorAll('#flash');
        alerts.forEach(function (alert) {
            setTimeout(() => {
                let fadeEffect = setInterval(() => {
                    if (!alert.style.opacity) {
                        alert.style.opacity = 1;
                    }
                    if (alert.style.opacity > 0) {
                        alert.style.opacity -= 0.05;
                    } else {
                        clearInterval(fadeEffect);
                        alert.remove();
                    }
                }, 50);
            }, 3000);
        });
        // Add this to make dropdown work
        var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'))
        var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
            return new bootstrap.Dropdown(dropdownToggleEl)
        })
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-XVdNgI+Mcb4NzX2xymStsOvD8d7uw50/hFd8l5X9/fjFz6m6B3/8Gpnq67UeSz8P"
        crossorigin="anonymous"></script>



{% block javascripts %}
{% endblock %}

</body>

</html>
