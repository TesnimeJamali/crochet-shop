{% extends 'base.html.twig' %}

{% block title %}ImageCarousel{% endblock %}

{% block body %}
    <h1>ImageCarousel</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ image_carousel.id }}</td>
            </tr>
            <tr>
                <th>ImageName</th>
                <td>{{ image_carousel.imageName }}</td>
