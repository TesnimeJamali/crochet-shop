{% extends 'base.html.twig' %}

{% block body %}
    <div class="container my-5">
        <h2 class="text-center mb-4" style="color: #4B7F52;">Nos Clients</h2>
        <div class="table-responsive">
            <table class="table table-bordered table-hover rounded shadow-sm" style="background-color: #f9f9f9;">
                <thead class="text-white" style="background-color: #A3C9A8;">
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                    </tr>
                </thead>
                <tbody>
                    {% for client in clients %}
                        <tr style="background-color: #F0F7F4;">
                            <td>{{ loop.index }}</td>
                            <td>{{ client.nom }}</td>
                            <td>{{ client.prenom }}</td>
                            <td>{{ client.email }}</td>
                            <td>{{ client.telephone }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">Aucun client trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}



