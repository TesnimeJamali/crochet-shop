{% extends 'base.html.twig' %}
{% block title %}Admin Products{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
{% endblock %}

{% block body %}
    <h1>Product Management</h1>
    <a href="{{ path('admin_product_new') }}" class="btn btn-add mb-3">Add Product</a>
    <a href="{{ path('app_order_topselledAdmin',{'limit':10}) }}" class="btn btn-add mb-3">Voir les top ventes</a>
    <a href="{{ path('ajout_coupon') }}" class="btn btn-add mb-3">Ajout coupon</a>

    <div class="row">
        <a href="{{ path('admin_carousel_upload') }}" class="btn btn-secondary mb-3">Ajouter Image au Carrousel</a>

        {% for product in products %}
            <div class="col-md-3 mb-4">
                    <div class="card h-100 product-card">
                        {% if product.imageName %}
                            <img src="{{ asset('uploads/products/' ~ product.imageName) }}" class="card-img-top" alt="{{ product.name }}">
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title text-dark">{{ product.name }}</h5>
                            <p class="card-text text-muted">{{ product.description|slice(0, 100) ~ '...' }}</p>
                            <p class="card-text text-dark"><strong>{{ product.price }} DT</strong></p>
                            <p class="card-text text-dark">Quantity: {{ product.quantity }}</p>
                            <a href="{{ path('admin_product_edit', { id: product.id }) }}" class="btn btn-edit">Edit</a>
                            <a href="{{ path('admin_product_delete', { id: product.id }) }}" class="btn btn-delete"
                               onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                        </div>
                    </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
