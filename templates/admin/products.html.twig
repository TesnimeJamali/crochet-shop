{% extends 'base.html.twig' %}

{% block title %}Admin Products{% endblock %}

{% block body %}
    <h1>Product Management</h1>
    <a href="{{ path('admin_product_new') }}" class="btn btn-success mb-3">➕ Add Product</a>

    <div class="row">
        {% for product in products %}
            <div class="col-md-4 mb-4">
                <div class="card h-100 border border-primary">
                    <img src="{{ asset('uploads/products/' ~ product.image) }}" class="card-img-top" alt="{{ product.name }}">
                    <div class="card-body">
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="card-text">{{ product.description|slice(0, 100) ~ '...' }}</p>
                        <p class="card-text"><strong>{{ product.price }} €</strong></p>
                        <a href="{{ path('admin_product_edit', { id: product.id }) }}" class="btn btn-warning btn-sm">✏️ Edit</a>
                        <a href="{{ path('admin_product_delete', { id: product.id }) }}" class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this product?');">🗑 Delete</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
