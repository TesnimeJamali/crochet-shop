<div id="productsContainer" class="container p-3 row " >
{% for product in products %}
    <div class="col-md-3 mb-4">

        <div class="card h-100 product-card">
            {% if product.imageName %}
                <img src="{{ asset('uploads/products/' ~ product.imageName ) }}"
                     class="card-img-top"
                     alt="{{ product.name }}"
                     style="height: 180px; object-fit: cover;">
            {% endif %}

            <div class="card-body">
                <h5 class="card-title">{{ product.name }}</h5>
                <p class="card-text">
                    <strong>Prix:</strong> {{ product.price}} DT<br>
                    <strong>Vendu:</strong> {{ product.totalQuantity }}
                </p>
            </div>
        </div>
    </div>
{% endfor %}
</div>

