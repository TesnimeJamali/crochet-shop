{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/detail.css') }}">
    <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
    <link rel="stylesheet" href="{{ asset('css/edit.css') }}">

{% endblock %}
{% block title %}
    {{ product is defined ? 'Edit Product' : 'Add Product' }}
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">{{ product is defined ? 'Edit' : 'Add' }} Product</h1>
        {# ... autres champs du formulaire ... #}

        {# Champ image avec taille réduite #}
        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
            {{ form_label(form.price) }}
            {{ form_widget(form.price) }}
            {{ form_errors(form.price) }}

            {{ form_label(form.imageFile) }}

            {% if product and product.imageName %}
                <div class="current-image-preview mb-2" style="width: 150px;">
                    <img src="{{ vich_uploader_asset(product, 'imageFile') }}"
                         alt="Current product image"
                         class="img-fluid"
                         style="max-width: 100%; height: auto;">
                </div>
            {% endif %}

            {{ form_widget(form.imageFile.file) }}
            {{ form_errors(form.imageFile.file) }}

        </div>
        <button class="btn btn-edit mt-3">
            {{ product is defined ? 'Update' : 'Create' }}
        </button>
    </div>
{% endblock %}
