{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/detail.css') }}">
    <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
    <link rel="stylesheet" href="{{ asset('css/edit.css') }}">
{% endblock %}

{% block title %}
    {{ product is defined ? 'Modifier Produit' : 'Ajouter Produit' }}
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">{{ product is defined ? 'Modifier' : 'Ajouter' }} Produit</h1>
        {{ form_start(form, { attr: { enctype: 'multipart/form-data' } }) }}

        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
            {{ form_label(form.price) }}
            {{ form_widget(form.price) }}
            {{ form_errors(form.price) }}
            {{ form_label(form.quantity) }}
            {{ form_widget(form.quantity) }}
            {{ form_errors(form.quantity) }}

            {# Display current image only if product has an image #}
            {% if product is defined and product.imageName %}
                <div class="mb-3">
                    <label>Image Actuelle:</label><br>
                    <img src="{{ vich_uploader_asset(product, 'imageFile') }}"
                         alt="Product image"
                         class="img-thumbnail"
                         style="max-width: 200px;">
                </div>
            {% endif %}

            {# Image upload field for new or existing product #}
            <div class="mb-3">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile) }}
                {{ form_errors(form.imageFile) }}
            </div>
        </div>

        <button class="btn btn-edit mt-3">
            {{ product is defined ? 'Mettre à Jour' : 'Créer' }}
        </button>
        {{ form_end(form) }}
    </div>
{% endblock %}
