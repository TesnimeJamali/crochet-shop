{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/detail.css') }}">
    <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
    <link rel="stylesheet" href="{{ asset('css/edit.css') }}">

{% endblock %}
{% block title %}Ajouter Produit{% endblock %}

{% block body %}
    <h1>{{ product is defined ? 'Edit' : 'Add' }} Produit</h1>
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn btn-add mt-2">{{ product is defined ? 'Mettre à Jour' : 'Créer' }}</button>
    {{ form_end(form) }}
{% endblock %}
