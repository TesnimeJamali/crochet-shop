{% extends 'base.html.twig' %}
{% block title %}La Boutique{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
    <style>
        /* Style personnalisé pour les favoris */
        .favorite-icon {
            cursor: pointer;
            font-size: 1.25rem;
            transition: all 0.3s ease;
        }

        .favorite-icon i {
            color: #ced4da; /* Couleur inactive */
        }

        .favorite-icon:hover i {
            color: #ff8787; /* Couleur au survol */
        }

        .favorite-icon.active i {
            color: #fa5252; /* Couleur active - rouge vif */
            text-shadow: 0 0 5px rgba(250, 82, 82, 0.3);
        }

        /* Style spécifique pour la page des favoris */
        body.favoris-page .favorite-icon.active i {
            color: #e64980; /* Rose pour la page favoris */
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Nos Produits</h1>
    <div class="row">
        {% for product in products %}
            <div class="col-md-3 mb-4">
                <a href="{{ path('shop_product_details', {'id': product.id}) }}" class="text-decoration-none">
                    <div class="card h-100 product-card">
                        <a href="{{ path('product_details', {'id': product.id}) }}" class="text-decoration-none">
                            {% if product.imageName %}
                                <img src="{{ asset('uploads/products/' ~ product.imageName) }}" class="card-img-top" alt="{{ product.name }}">
                            {% endif %}
                        </a>
                        <div class="card-body">
                            <h5 class="card-title text-dark">
                                <a href="{{ path('product_details', {'id': product.id}) }}" class="text-dark text-decoration-none">{{ product.name }}</a>
                            </h5>

                            <p class="card-text text-muted">{{ product.description|slice(0, 100) ~ '...' }}</p>
                            <p class="card-text">
                                <strong> {{ product.price}} DT<br></strong>
                            </p>
                            {% if product.quantity > 5 %}
                                <p class="card-text stock-ok">En Stock</p>
                            {% elseif product.quantity > 0 %}
                                <p class="card-text stock-warning">Stock Limité ({{ product.quantity }} restant{{ product.quantity == 1 ? '' : 's' }})</p>
                            {% else %}
                                <p class="card-text stock-out">Stock Épuisé</p>
                                <a href="{{ path('alerte_stock', {'id': product.id}) }}" class="card-text stock-out"> M’avertir quand l’article revient</a>

                            {% endif %}
                            <div class="mt-3 d-flex justify-content-between align-items-center">
                                <a href="{{ path('add', {'id': product.id}) }}" class="btn custom-cart-btn">
                                    <i class="fas fa-cart-plus me-1"></i> Ajouter
                                </a>

                                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                                    <a href="#" class="favorite-icon favorite-icon2 ms-2 {{ app.user and product in app.user.favoris ? 'active' : '' }}"
                                       data-product-id="{{ product.id }}">
                                        <i class="fa-heart {{ app.user and product in app.user.favoris ? 'fa-solid' : 'fa-regular' }}"></i>
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_login')}} " class="favorite-icon ms-2 {{ app.user and product in app.user.favoris ? 'active' : '' }}"
                                       data-product-id="{{ product.id }}">
                                        <i class="fa-heart {{ app.user and product in app.user.favoris ? 'fa-solid' : 'fa-regular' }}"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </a>
            </div>
        {% endfor %}
    </div>

{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.addEventListener('click', async function(e) {
                if (e.target.closest('.favorite-icon2')) {
                    e.preventDefault();
                    const icon = e.target.closest('.favorite-icon2');
                    const productId = icon.dataset.productId;
                    const heartIcon = icon.querySelector('i');

                    try {
                        const response = await fetch(`/favoris/toggle/${productId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({
                                '_token': '{{ csrf_token('favoris') }}'
                            })
                        });

                        const data = await response.json();

                        if (!response.ok) {
                            if (response.status === 401) {
                                window.location.href = '/login';
                            }
                            throw new Error(data.error || 'Erreur serveur');
                        }

                        if (data.status === 'added') {
                            heartIcon.classList.replace('fa-regular', 'fa-solid');
                            icon.classList.add('active');
                        } else if (data.status === 'removed') {
                            heartIcon.classList.replace('fa-solid', 'fa-regular');
                            icon.classList.remove('active');

                            // Si sur la page favoris, supprimer la carte
                            if (window.location.pathname === '/favoris') {
                                icon.closest('.col').remove();
                                updateFavorisCount();
                            }
                        }

                    } catch (error) {
                        console.error('Erreur:', error);
                        alert('Une erreur est survenue: ' + error.message);
                    }
                }
            });

            function updateFavorisCount() {
                const count = document.querySelectorAll('.favorite-icon.active').length;
                document.querySelector('.badge').textContent = `${count} produit${count !== 1 ? 's' : ''}`;

                if (count === 0) {
                    document.querySelector('.row').innerHTML = `
                <div class="col-12 text-center py-5">
                    <i class="far fa-heart fa-5x text-muted mb-4"></i>
                    <h3>Votre liste de favoris est vide</h3>
                    <a href="{{ path('shop') }}" class="btn btn-primary mt-3">
                        Parcourir les produits
                    </a>
                </div>
            `;
                }
            }
        });
    </script>
{% endblock %}
