{% extends 'base.html.twig' %}
{% block title %}The Shop{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
{% endblock %}
{% block body %}
    <h1>Our Crochet Products</h1>
    <div class="row">
        {% for product in products %}
            <div class="col-md-3 mb-4">
                <a href="{{ path('shop_product_details', {'id': product.id}) }}" class="text-decoration-none">
                    <div class="card h-100 product-card">
                        <a href="{{ path('product_details', {'id': product.id}) }}" class="text-decoration-none">
                            {% if product.imageName %}
                                <img src="{{ asset('uploads/products/' ~ product.imageName) }}" class="card-img-top" alt="{{ product.name }}">
                            {% endif %}
                        </a>
                        <div class="card-body">
                            <h5 class="card-title text-dark">
                                <a href="{{ path('product_details', {'id': product.id}) }}" class="text-dark text-decoration-none">{{ product.name }}</a>
                            </h5>

                            <p class="card-text text-muted">{{ product.description|slice(0, 100) ~ '...' }}</p>
                            <p class="card-text text-dark"><strong>{{ product.price }} DT</strong></p>

                            <div class="mt-3 d-flex justify-content-between align-items-center">
                                <a href="{{ path('add', {'id': product.id}) }}" class="btn custom-cart-btn">
                                    <i class="fas fa-cart-plus me-1"></i> Ajouter
                                </a>

                                <a href="#" class="favorite-icon ms-2 {{ app.user and product in app.user.favoris ? 'active' : '' }}"
                                   data-product-id="{{ product.id }}">
                                    <i class="fa-heart {{ app.user and product in app.user.favoris ? 'fa-solid' : 'fa-regular' }}"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                </a>
            </div>
        {% endfor %}
    </div>

{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.addEventListener('click', async function(e) {
                if (e.target.closest('.favorite-icon')) {
                    e.preventDefault();
                    const icon = e.target.closest('.favorite-icon');
                    const productId = icon.dataset.productId;
                    const heartIcon = icon.querySelector('i');

                    try {
                        const response = await fetch(`/favoris/toggle/${productId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({
                                '_token': '{{ csrf_token('favoris') }}'
                            })
                        });

                        const data = await response.json();

                        if (!response.ok) {
                            if (response.status === 401) {
                                window.location.href = '/login';
                            }
                            throw new Error(data.error || 'Erreur serveur');
                        }

                        if (data.status === 'added') {
                            heartIcon.classList.replace('fa-regular', 'fa-solid');
                            icon.classList.add('active');
                        } else if (data.status === 'removed') {
                            heartIcon.classList.replace('fa-solid', 'fa-regular');
                            icon.classList.remove('active');

                            // Si sur la page favoris, supprimer la carte
                            if (window.location.pathname === '/favoris') {
                                icon.closest('.col').remove();
                                updateFavorisCount();
                            }
                        }

                    } catch (error) {
                        console.error('Erreur:', error);
                        alert('Une erreur est survenue: ' + error.message);
                    }
                }
            });

            function updateFavorisCount() {
                const count = document.querySelectorAll('.favorite-icon.active').length;
                document.querySelector('.badge').textContent = `${count} produit${count !== 1 ? 's' : ''}`;

                if (count === 0) {
                    document.querySelector('.row').innerHTML = `
                <div class="col-12 text-center py-5">
                    <i class="far fa-heart fa-5x text-muted mb-4"></i>
                    <h3>Votre liste de favoris est vide</h3>
                    <a href="{{ path('shop') }}" class="btn btn-primary mt-3">
                        Parcourir les produits
                    </a>
                </div>
            `;
                }
            }
        });
    </script>
{% endblock %}
