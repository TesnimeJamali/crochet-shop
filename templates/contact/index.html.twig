{% extends 'base.html.twig' %}

{% block title %}Contactez-nous{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <h1 class="display-4 mb-4">Contactez-nous</h1>
                <p class="lead text-muted"><strong>Nous acceuillons vos commandes personnalisés, vos recommendations et surtout votre soutien!</strong></p>

                <div class="my-5">
                    <img src="{{ asset('image/logo.png') }}" alt="Crochet D'or" class="rounded-circle shadow" width="200" height="200" style="object-fit: cover; border: 5px solid #ffdeeb;">
                </div>

                <div class="card shadow-sm border-0" style="border-radius: 20px;">
                    <div class="card-body p-5">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="p-4 bg-pink-light rounded" style="background-color: #fff0f6;">
                                    <h3 class="h5"><i class="fas fa-envelope me-2" style="color: #fdb2b2;"></i> Email</h3>
                                    <p>crochetdor.tn@gmail.com</p>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="p-4 bg-pink-light rounded" style="background-color: #fff0f6;">
                                    <h3 class="h5"><i class="fas fa-phone-alt me-2" style="color: #fdb2b2;"></i> Téléphone</h3>
                                    <p>+216 28 28 44 28</p>
                                </div>
                            </div>
                        </div>

                        {{ form_start(form) }}
                        {{ form_row(form.name) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.message) }}

                        {# Rendre le bouton submit avec le widget, et ajouter classes et icône #}
                        {{ form_widget(form.submit, {
                            'attr': {'class': 'btn btn-pink btn-lg px-4 py-2 rounded-pill'}
                        }) }}
                        {{ form_end(form) }}

                    </div>
                </div>

                <div class="mt-5">
                    <h4 class="mb-3">Retrouvez-nous aussi sur :</h4>
                    <div>
                        <a href="https://www.instagram.com/crochetdor.tn/" class="btn btn-outline-pink btn-lg mx-2 rounded-circle"><i class="fab fa-instagram" style="color: #fdb2b2;"></i></a>
                   </div>
                </div>
            </div>
        </div>
    </div>

    <style>


        form label {
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
            color: #333;
        }

        form input[type="text"],
        form input[type="email"],
        form textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 12px;
            border: 1px solid #ffc9c9;
            font-size: 16px;
            background-color: #fff0f5;
            transition: all 0.3s ease;
        }

        form input:focus,
        form textarea:focus {
            outline: none;
            border-color: #f4978e;
            box-shadow: 0 0 8px rgba(244, 151, 142, 0.3);
            background-color: #fff;
        }

        .btn-pink {
            background-color: #f4978e;
            color: white;
            padding: 10px 25px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.3s ease;
        }

        .btn-pink:hover {
            background-color: #e87d75;
        }
        .btn-pink {
            background-color: #fdb2b2;
            color: white;
            border: none;
            transition: all 0.3s;
        }
        .btn-pink:hover {
            background-color: #cf8787;
            transform: translateY(-2px);
        }
        .btn-outline-pink {
            color: #fdb2b2;
            border-color: #fdb2b2;
            transition: all 0.3s;
        }
        .btn-outline-pink:hover {
            background-color: #fff;
            color: white;
            transform: scale(1.1);
        }
        .bg-pink-light {
            background-color: #fff0f6;
        }
    </style>
{% endblock %}