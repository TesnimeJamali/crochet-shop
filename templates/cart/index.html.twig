{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
    <div class="container my-5">
        <h2 class="mb-4 text-center fw-semibold" style="font-family: 'Segoe UI', sans-serif; font-size: 2rem;">
            Mon Panier
        </h2>
        {% if info_panier is empty %}
            <div class="alert alert-secondary text-center fs-5">
                Votre panier est vide pour le moment.
            </div>
        {% else %}
            <div class="list-group">
                {% for item in info_panier %}
                    <div class="list-group-item py-4 px-3 mb-3 shadow-sm rounded d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                        <div class="d-flex align-items-center mb-3 mb-md-0">
                            <img src="{{ asset('uploads/products/' ~ item.produit.imageName) }}" alt="{{ item.produit.name }}" class="me-4 rounded shadow-sm border" style="width: 100px; height: 100px; object-fit: cover;">

                            <div>
                                <h5 class="mb-1">
                                    <a href="{{ path('product_details', {id: item.produit.id}) }}" class="text-decoration-none text-dark fw-bold" style="transition: color 0.3s;">
                                        {{ item.produit.name }}
                                    </a>
                                </h5>
                                <p class="mb-1 text-muted small">
                                    Prix unitaire : <strong>{{ item.produit.price|number_format(2, '.', ' ') }} DT</strong><br>
                                    Quantité : <strong>{{ item.quantite }}</strong>
                                </p>
                                <p class="mb-0 text-dark">Total :
                                    <strong>{{ (item.produit.price * item.quantite)|number_format(2, '.', ' ') }} DT</strong>
                                </p>
                            </div>
                        </div>
                        <div class="text-md-end">
                            <div class="btn-group" role="group">
                                <a href="{{ path('add', {id: item.produit.id}) }}" class="btn btn-outline-success" title="Ajouter">
                                    <i class="bi bi-plus-circle"></i>
                                </a>
                                <a href="{{ path('remove', {id: item.produit.id}) }}" class="btn btn-outline-warning" title="Retirer">
                                    <i class="bi bi-dash-circle"></i>
                                </a>
                                <a href="{{ path('delete', {id: item.produit.id}) }}" class="btn btn-outline-danger" title="Supprimer">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    {% if item.produit.quantity == 0 %}
                <div class="alert mt-3 text-center" style="background-color: #e6f0ff; border-color: #cce0ff; color: #003366;">
                <p class="fs-5 mb-3" style="font-weight: 500;">
                Le produit <strong>"{{ item.produit.name }}"</strong> n’est plus en stock.
                </p>
                <a href="{{ path('alerte_stock', {id: item.produit.id}) }}" class="btn px-4 py-2"
                   style="background-color: #d1e7ff; color: #004080; border: none;">
                    Être averti quand il est de nouveau disponible
                </a>
            </div>
        {% endif %}



        {% endfor %}
            </div>
            <div class="card mt-5 border-success shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-semibold">Total général :</h4>
                    {% if coupon %}
                        <h3 class="text-muted mb-0" style="text-decoration: line-through;">
                            {{ total|number_format(2, '.', ' ') }} DT
                        </h3>
                        {% set remise = total * coupon.discount / 100 %}
                        <h3 class="text-success mb-0">
                            {{ (total - remise)|number_format(2, '.', ' ') }} DT
                        </h3>
                    {% else %}
                        <h3 class="text-dark mb-0">
                            {{ total|number_format(2, '.', ' ') }} DT
                        </h3>
                    {% endif %}

                </div>
            </div>
            <div class="card mt-5 border-0 shadow-sm" style="background-color: #fff0f5;">
                <div class="card-header d-flex align-items-center" style="background-color: #fce4ec;">
                    <i class="bi bi-ticket-perforated-fill text-danger fs-4 me-2"></i>
                    <h5 class="mb-0 text-dark">Code promotionnel</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ path('apply_coupon') }}" class="row gy-2 gx-3 align-items-center">
                        <div class="col-md-8">
                            <div class="input-group">
                    <span class="input-group-text bg-white border-pink" style="border-color: #f48fb1;">
                        <i class="bi bi-percent text-danger"></i>
                    </span>
                                <input type="text" class="form-control border-pink" name="code" placeholder="Saisissez votre code promo"
                                       style="border-color: #f48fb1;">
                            </div>
                        </div>
                        <div class="col-md-4 d-grid">
                            <button type="submit" class="btn text-white" style="background-color: #f48fb1;">
                                <i class="bi bi-check2-circle me-1"></i> Appliquer
                            </button>
                        </div>
                    </form>

                    {% if coupon_error is defined %}
                        <div class="alert alert-danger mt-3 mb-0 rounded-1" style="background-color: #f8d7da;">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>{{ coupon_error }}
                        </div>
                    {% elseif coupon_success is defined %}
                        <div class="alert alert-success mt-3 mb-0 rounded-1" style="background-color: #d4edda;">
                            <i class="bi bi-check-circle-fill me-2"></i>{{ coupon_success }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="text-center mt-5">
                <div class="d-inline-flex flex-wrap justify-content-center gap-3">
                    <a href="{{ path('app_order_new') }}"
                       class="btn btn-lg px-4 shadow-sm"
                       style="background-color: #c8e6c9; color: #2e7d32;">
                        <i class="bi bi-credit-card-fill me-2"></i> Valider mon panier
                    </a>
                    <a href="{{ path('shop') }}"
                       class="btn btn-lg px-4 shadow-sm"
                       style="background-color: #d1c4e9; color: #4527a0;">
                        <i class="bi bi-arrow-left-circle me-2"></i> Continuer mes achats
                    </a>
                    <a href="{{ path('cart_clear') }}"
                       class="btn btn-lg px-4 shadow-sm"
                       style="background-color: #f8bbd0; color: #c2185b;">
                        <i class="bi bi-trash-fill me-2"></i> Vider le panier
                    </a>

                </div>
            </div>


        {% endif %}
    </div>
{% endblock %}
