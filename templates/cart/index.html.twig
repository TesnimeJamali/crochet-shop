{% extends 'base.html.twig' %}

{% block title %}Hello CartController!{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }
    </style>


    <h1>Votre panier</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Produit</th>
            <th>Prix</th>
            <th>Quantité</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
        <tbody>
        {% for item in info_panier %}
            <tr>
                <td>{{ item.produit.name }}</td>
                <td class="text-center">{{ item.produit.price }}</td>
                <td>{{ item.quantite }}
                </td>
                <td class="text-center">{{ (item.produit.price)*(item.quantite) }}</td>
                <td>
                    <a href="{{ path('add', {id: item.produit.id}) }}" class="btn btn-success"><i
                                class="bi bi-cart-plus"></i></a>
                    <a href="{{ path('remove', {id: item.produit.id}) }}" class="btn btn-warning"><i class="bi bi-cart-dash"></i></a>
                    <a href="{{ path('delete', {id: item.produit.id}) }}" class="btn btn-danger"><i
                                class="bi bi-cart-x"></i></a>
                </td>


            </tr>

        {% else %}
            <tr>
                <td colspan="5" class="text-center">Votre panier est vide</td>
            </tr>

        {% endfor %}
        </tbody>
        <tfoot>
        <td colspan="3">Total</td>
        <td class="text-center">{{ total }} </td>
        <td><a href="{{ path('app_order_new') }}" class="btn btn-danger">Validate Order</a></td>

        </tfoot>
        </thead>
    </table>

{% endblock %}
