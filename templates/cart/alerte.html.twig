{% extends 'base.html.twig' %}

{% block title %}Alerte Stock{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-12">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-header text-center bg-light">
                        <h5 class="fw-semibold text-dark mb-0">Recevez une alerte dès que ce produit est de nouveau en stock</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted text-center mb-4">Entrez votre email pour être averti dès la disponibilité du produit.</p>

                        {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.email, 'Votre email', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.email, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Entrez votre email',
                                    'style': 'border: 1px solid #ccc;'
                                }
                            }) }}
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg px-4 py-2">
                                Être averti
                            </button>
                        </div>
                        {{ form_end(form) }}

                        <div class="text-center mt-4">
                            <a href="{{ path('app_cart') }}" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left-circle"></i> Revenir vers mon panier
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
