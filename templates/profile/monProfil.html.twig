{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4" style="background-color: #fefefe;">
                    <div class="card-header text-center py-3 rounded-top-4" style="background-color: #e3f3f8;">
                        <h3 class="fw-light mb-0" style="color: #5a6d80;">
                            <i class="fas fa-id-badge me-3" style="color: #8bc1d4;"></i>
                            Bienvenue sur votre espace personnel
                        </h3>
                    </div>
                    <div class="card-body px-4 py-3">
                        <div class="mb-3">
                            <h5 class="mb-1" style="color: #5a6d80;">
                                <i class="fas fa-user-circle me-2" style="color: #f8d4dc;"></i>
                                {{ app.user.prenom }} {{ app.user.nom }}
                            </h5>
                            <p class="text-muted small mb-1">
                                <i class="fas fa-envelope me-2" style="color: #f8d4dc;"></i>
                                {{ app.user.email }}
                            </p>
                            <p class="text-muted small mb-0">
                                <i class="fas fa-phone me-2" style="color: #f8d4dc;"></i>
                                {{ app.user.telephone }}
                            </p>
                        </div>

                        <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                            <a href="{{ path('app_order_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill">
                                <i class="fas fa-shopping-bag me-2"></i>Mes Commandes
                            </a>
                            <a href="{{ path('app_cart') }}" class="btn btn-outline-secondary btn-sm rounded-pill">
                                <i class="fas fa-shopping-cart me-2"></i>Mon Panier
                            </a>
                            <a href="{{ path('app_profile_edit') }}"  class="btn btn-outline-secondary btn-sm rounded-pill">
                                <i class="fas fa-user-edit me-2"></i>Modifier Profil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        body {
            background-color: #f4f9fb;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }

        .card {
            transition: transform 0.2s ease-in-out;
        }

        .card:hover {
            transform: translateY(-3px);
        }

        .btn-outline-secondary {
            border: 1px solid #d0e8f2;
            color: #5a6d80;
            background-color: #fff;
        }

        .btn-outline-secondary:hover {
            background-color: #f0f4f8;
            color: #4a5b6d;
        }
    </style>
{% endblock %}
