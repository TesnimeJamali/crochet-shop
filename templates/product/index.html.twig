{% extends 'base.html.twig' %}

{% block title %}Products - Crochet D'Or{% endblock %}

{% block body %}
    <div class="row">
        {% for product in products %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="{{ asset('uploads/products/' ~ product.image) }}" class="card-img-top" alt="{{ product.name }}">
                    <div class="card-body">
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="card-text">{{ product.description|length > 100 ? product.description|slice(0, 100) ~ '...' : product.description }}</p>
                        <p class="card-text"><strong>{{ product.price }} €</strong></p>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
