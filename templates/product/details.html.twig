
{% extends 'base.html.twig' %}
{% block title %}{{ product.name }}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/detail.css') }}">
    <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
{% endblock %}
{% block body %}
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6">
                {# Check if the product has an image before displaying it #}
                {% if product.imageName %}
                    <img src="{{ asset('uploads/products/' ~ product.imageName) }}" class="img-fluid" alt="{{ product.name }}">
                {% else %}
                    <img src="{{ asset('images/default_product_image.jpg') }}" class="img-fluid" alt="Default Image">
                {% endif %}
            </div>
            <div class="col-md-6">
                <h1>{{ product.name }}</h1>
                <p class="lead">{{ product.price }} DT</p>
                <p>{{ product.description }}</p>
                <a href="{{ path('add', {'id': product.id}) }}" class="btn custom-cart-btn">Add to Cart</a>
            </div>
        </div>
    </div>
{% endblock %}
